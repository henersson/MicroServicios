# Convenciones de formato compartidas por todo el repositorio.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,proto,md}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.java]
indent_size = 4
max_line_length = 120

# Los scripts de Windows usan CRLF (coherente con .gitattributes) y UTF-8 CON BOM:
# sin BOM, Windows PowerShell 5.1 lee los .ps1 como ANSI y los acentos rompen el
# parser.
[*.{ps1,cmd,bat}]
end_of_line = crlf
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
