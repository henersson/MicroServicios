# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copiar a `.env` (ignorado por git) con:
#   Copy-Item .env.example .env
# Los valores de aquí son SOLO para desarrollo local. Nunca subir `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL del banco-preguntas-service ──────────────────────────────────
POSTGRES_BANCO_DB=banco_preguntas
POSTGRES_BANCO_USER=banco
POSTGRES_BANCO_PASSWORD=banco
POSTGRES_BANCO_PORT=5433

# ── PostgreSQL del revision-service ─────────────────────────────────────────
POSTGRES_REVISION_DB=revision
POSTGRES_REVISION_USER=revision
POSTGRES_REVISION_PASSWORD=revision
POSTGRES_REVISION_PORT=5434

# ── PostgreSQL del simulacros-service (reservado, lo implementan compañeros) ─
# POSTGRES_SIMULACROS_DB=simulacros
# POSTGRES_SIMULACROS_USER=simulacros
# POSTGRES_SIMULACROS_PASSWORD=simulacros
# POSTGRES_SIMULACROS_PORT=5435

# ── RabbitMQ ────────────────────────────────────────────────────────────────
# Estas credenciales deben coincidir con infra/rabbitmq/definitions.json:
# al cargar definiciones, RabbitMQ IGNORA RABBITMQ_DEFAULT_USER/PASS.
RABBITMQ_USER=saberpro
RABBITMQ_PASSWORD=saberpro
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── Puertos publicados por los servicios ────────────────────────────────────
BANCO_HTTP_PORT=8081
BANCO_GRPC_PORT=9091
REVISION_HTTP_PORT=8082
# SIMULACROS_HTTP_PORT=8083

# ── Conexiones desde DENTRO de Docker (perfil `docker`) ─────────────────────
# Las usa docker-compose.yml al levantar los servicios en la red saberpro-net.
BANCO_DATABASE_URL=postgresql://banco:banco@postgres-banco:5432/banco_preguntas
REVISION_DATABASE_URL=postgresql://revision:revision@postgres-revision:5432/revision
RABBITMQ_URL=amqp://saberpro:saberpro@rabbitmq:5672/
BANCO_GRPC_ADDR=banco-preguntas-service:9091

# ── Mensajería ──────────────────────────────────────────────────────────────
EVENTOS_EXCHANGE=saberpro.eventos
EVENTOS_DLX=saberpro.eventos.dlx

# ── Reglas de negocio configurables ─────────────────────────────────────────
# Invariante 3: longitud mínima de una opción (caracteres sin contar espacios).
BANCO_OPCION_LONGITUD_MINIMA=5
# Invariante 10: promedio mínimo del formato de evaluación para aprobar.
REVISION_PROMEDIO_MINIMO_APROBACION=3.0

# ─────────────────────────────────────────────────────────────────────────────
# TERCER MICROSERVICIO (simulacros-service) — descomentar al implementarlo
#
# Estas son las variables que espera, segun docs/GUIA_INTEGRACION.md. El formato
# de DATABASE_URL depende del driver del lenguaje que elijan: el de abajo es la
# URI estandar de PostgreSQL, que sirve para Node, Go, .NET y PHP. En Java haria
# falta el formato JDBC, como en BANCO_DATABASE_URL.
# ─────────────────────────────────────────────────────────────────────────────

# Dentro de Docker (red saberpro-net)
# SIMULACROS_DATABASE_URL=postgresql://simulacros:simulacros@postgres-simulacros:5432/simulacros
# BANCO_REST_URL=http://banco-preguntas-service:8081

