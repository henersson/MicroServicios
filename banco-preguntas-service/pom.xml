<?xml version="1.0" encoding="UTF-8"?>
<!--
  banco-preguntas-service — Bounded Context "Banco de Preguntas".

  Generado con start.spring.io (trae el Maven Wrapper, no hace falta instalar
  Maven: se usa .\mvnw.cmd). Todas las versiones quedan fijas: las gestionadas
  por el parent de Spring Boot y, las que no, declaradas en <properties>.

  Nota sobre el gRPC: el codigo de los mensajes y del servicio se genera al
  compilar a partir de ../contracts/proto, que es el contrato compartido. Por eso
  el Dockerfile construye con el contexto en la raiz del repositorio.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>co.edu.unicauca.saberpro</groupId>
	<artifactId>banco-preguntas-service</artifactId>
	<version>1.0.0</version>
	<name>banco-preguntas-service</name>
	<description>Microservicio del Bounded Context Banco de Preguntas (Taller 2, Arquitectura de Microservicios)</description>

	<properties>
		<java.version>21</java.version>
		<!-- Versiones fijas de lo que no gestiona el parent de Spring Boot. -->
		<springdoc.version>3.1.1</springdoc.version>
		<archunit.version>1.5.0</archunit.version>
		<!-- Ruta al contrato gRPC compartido. Es relativa para que funcione igual
		     en Windows y dentro del contenedor Linux. -->
		<contracts.proto.dir>${project.basedir}/../contracts/proto</contracts.proto.dir>
	</properties>

	<dependencies>
		<!-- ── Capa de interfaces: API REST ─────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Swagger UI, que documenta la API REST en vivo. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- ── Infraestructura: persistencia propia del microservicio ───────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ── Infraestructura: mensajeria (RabbitMQ) ───────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!-- ── Infraestructura: servidor gRPC (puerto 9091, con reflection) ─── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-grpc-server</artifactId>
		</dependency>
		<!-- Server Reflection: permite explorar el servicio con grpcurl o Postman
		     sin tener que cargar el .proto a mano. -->
		<dependency>
			<groupId>io.grpc</groupId>
			<artifactId>grpc-services</artifactId>
		</dependency>

		<!-- ── Observabilidad ───────────────────────────────────────────────── -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- ── Tests ────────────────────────────────────────────────────────── -->
		<!-- JUnit 5 y AssertJ, que es lo que usan los tests de dominio. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Verifica que el dominio no dependa de las demas capas (Clean Architecture). -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Genera las clases Java de los mensajes y del servicio gRPC a partir
			     del contrato compartido. El parent de Spring Boot ya fija la version
			     de protoc y engancha protoc-gen-grpc-java; aqui solo se le dice
			     donde esta el .proto. -->
			<plugin>
				<groupId>io.github.ascopes</groupId>
				<artifactId>protobuf-maven-plugin</artifactId>
				<configuration>
					<sourceDirectories>
						<sourceDirectory>${contracts.proto.dir}</sourceDirectory>
					</sourceDirectories>
				</configuration>
			</plugin>

			<!-- Registra el codigo gRPC generado como carpeta de fuentes de forma que
			     el IDE la vea. VS Code (m2e) no ejecuta protobuf-maven-plugin, pero si
			     entiende build-helper; sin esto marca como inexistentes las clases de
			     ...banco.grpc.v1 aunque Maven compile bien. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>fuentes-grpc-generadas</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/protobuf</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- En Windows la ruta del repositorio es tan larga que la de protoc.exe dentro
		     de target/ pasa de 260 caracteres, y CreateProcess no lo puede lanzar
		     (ni con LongPathsEnabled). Este perfil hace que el plugin copie protoc y
		     protoc-gen-grpc-java a una ruta corta antes de ejecutarlos. En Linux (el
		     Dockerfile) no se activa. -->
		<profile>
			<id>windows-rutas-largas</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<protobuf.sanctioned-executable-path>${user.home}/.m2/protoc</protobuf.sanctioned-executable-path>
			</properties>
		</profile>
	</profiles>

</project>
