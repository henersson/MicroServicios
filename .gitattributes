# Normalización por defecto: git decide, en el repositorio siempre LF.
* text=auto eol=lf

# ── Deben tener LF SIEMPRE: se ejecutan dentro de contenedores Linux ─────────
mvnw            text eol=lf
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
docker-compose.yml text eol=lf
*.conf          text eol=lf
entrypoint*     text eol=lf

# ── Deben tener CRLF: solo se ejecutan en Windows ───────────────────────────
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# ── Contratos y documentación (LF por el default de arriba, explícito) ──────
*.proto         text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.java          text eol=lf
*.py            text eol=lf
*.sql           text eol=lf

# ── Binarios: nunca tocar ────────────────────────────────────────────────────
*.jar           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.pdf           binary
*.ico           binary
